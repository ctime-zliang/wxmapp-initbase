{
	"name": "wxmapp-initbase",
	"version": "1.0.0",
	"private": true,
	"description": "wxmapp-initbase",
	"templateInfo": {
		"name": "default",
		"typescript": true,
		"css": "Sass",
		"framework": "React"
	},
	"scripts": {
		"prettier:write-all": "prettier --write .",
		"prettier:check-all": "prettier --check .",
		"dev:weapp": "cross-env NODE_ENV=development taro build --type weapp --watch",
		"dev:swan": "cross-env NODE_ENV=development taro build --type swan --watch",
		"dev:alipay": "cross-env NODE_ENV=development taro build --type alipay --watch",
		"dev:tt": "cross-env NODE_ENV=development taro build --type tt --watch",
		"dev:h5": "cross-env NODE_ENV=development taro build --type h5 --watch",
		"dev:rn": "cross-env NODE_ENV=development taro build --type rn --watch",
		"dev:qq": "cross-env NODE_ENV=development taro build --type qq --watch",
		"dev:jd": "cross-env NODE_ENV=development taro build --type jd --watch",
		"dev:quickapp": "cross-env NODE_ENV=development taro build --type quickapp --watch",
		"dev:harmony-hybrid": "cross-env NODE_ENV=development taro build --type harmony-hybrid --watch",
		"build:weapp": "cross-env NODE_ENV=production taro build --type weapp",
		"build:swan": "cross-env NODE_ENV=production taro build --type swan",
		"build:alipay": "cross-env NODE_ENV=production taro build --type alipay",
		"build:tt": "cross-env NODE_ENV=production taro build --type tt",
		"build:h5": "cross-env NODE_ENV=production taro build --type h5",
		"build:rn": "cross-env NODE_ENV=production taro build --type rn",
		"build:qq": "cross-env NODE_ENV=production taro build --type qq",
		"build:jd": "cross-env NODE_ENV=production taro build --type jd",
		"build:quickapp": "cross-env NODE_ENV=production taro build --type quickapp",
		"build:harmony-hybrid": "cross-env NODE_ENV=production taro build --type harmony-hybrid",
		"postinstall": "weapp-tw patch"
	},
	"browserslist": [
		"last 3 versions",
		"Android >= 4.1",
		"ios >= 8"
	],
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	},
	"lint-staged": {
		"src/**/*.{js,jsx,ts,tsx}": [
			"eslint --fix",
			"git add"
		]
	},
	"author": "",
	"dependencies": {
		"@babel/runtime": "^7.24.4",
