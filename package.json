		"@tarojs/taro": "4.1.11",
		"cross-env": "^10.1.0",
		"lodash-es": "^4.17.21",
		"react": "^18.0.0",
		"react-dom": "^18.0.0",
		"weapp-qrcode": "^1.0.0"
	},
	"devDependencies": {
		"@babel/core": "^7.24.4",
		"@babel/plugin-transform-class-properties": "7.25.9",
		"@babel/preset-react": "^7.24.1",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@pmmmwh/react-refresh-webpack-plugin": "^0.5.5",
		"@tailwindcss/postcss": "^4.2.1",
		"@tarojs/cli": "4.1.11",
